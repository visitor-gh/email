# Server Configuration
PORT=3001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google OAuth2 (Gmail)
# Setup: https://console.cloud.google.com/ → APIs & Services → Credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add http://localhost:3001/api/accounts/oauth/callback to Authorized redirect URIs
# 3. Enable Gmail API
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/accounts/oauth/callback

# Encryption key for storing email passwords
ENCRYPTION_KEY=your-32-character-encryption-key!!

# Session Secret
SESSION_SECRET=your-session-secret-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
